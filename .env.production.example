NODE_ENV=production
HOST=0.0.0.0
PORT=4173
APP_DOMAIN=jobs.example.com
ACME_EMAIL=admin@example.com

# 腾讯云短信：全部为必填。短信模板变量顺序必须是 {1}=验证码、{2}=有效分钟数。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
SMS_CODE_MINUTES=5

# 可选：只在自建短信网关时使用；配置腾讯云短信后不读取这里。
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
