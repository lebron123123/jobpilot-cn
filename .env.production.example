NODE_ENV=production
HOST=0.0.0.0
PORT=4173
APP_DOMAIN=jobs.example.com
ACME_EMAIL=admin@example.com

# 腾讯云 API 凭证：使用仅授权邮件/短信发送的 CAM 子用户，禁止使用主账号密钥。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 腾讯云 SES 邮箱验证码：个人认证账号使用 API 发送。模板变量为 {{code}} 和 {{minutes}}。
TENCENT_SES_FROM_EMAIL=JobPilot CN <noreply@mail.example.com>
TENCENT_SES_TEMPLATE_ID=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_SUBJECT=JobPilot CN 注册验证码
TENCENT_SES_REPLY_TO=
EMAIL_CODE_MINUTES=5

# 腾讯云短信：办理企业资质后再配置。模板变量顺序必须是 {1}=验证码、{2}=有效分钟数。
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
SMS_CODE_MINUTES=5

# 可选：只在自建短信网关时使用；配置腾讯云短信后不读取这里。
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
